{
    "name": "thunla/lms-shared-library",
    "description": "Shared library for LMS",
    "authors": [
        {
            "name": "Thunla",
            "email": "thunla1202@gmail.com"
        }
    ],
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "symfony/dependency-injection": "^7.0 || ^8.1",
        "symfony/http-foundation": "^7.0 || ^8.1",
        "symfony/http-kernel": "^7.0 || ^8.1",
        "symfony/framework-bundle": "^7.0 || ^8.1",
        "symfony/yaml": "^7.0 || ^8.1"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "bundle": "Lms\\Shared\\LmsSharedBundle"
        }
    },
    "autoload": {
        "psr-4": {
            "Lms\\Shared\\": "src/"
        }
    }
}
